{
  "name": "react-chrome-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension boilerplate built with React, TypeScript and Vite, using the inject-page strategy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satendra02/react-chrome-extension.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "zip": "npm run build && rm -f extension.zip && cd dist && zip -qr ../extension.zip . && echo \"created extension.zip\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-frame-component": "^5.3.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
